// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────────────────────────
// Company-level settings (single row, id = "main")
// ───────────────────────────────────────────────
model Company {
  id              String   @id @default("main")
  name            String
  shortName       String
  legalEntity     String
  tagline         String
  description     String
  foundedYear     Int
  headquarters    String
  phone           String
  phoneRaw        String
  email           String
  hours           String
  linkedinUrl     String   @default("#")
  instagramUrl    String   @default("#")
  facebookUrl     String   @default("#")
  whatsappUrl     String   @default("#")
  partnerBrands   String[] @default([])
  updatedAt       DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Hero stats (small counter items on homepage)
// ───────────────────────────────────────────────
model HeroStat {
  id        String   @id
  value     Int
  suffix    String
  label     String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Value items ("What we stand for")
// ───────────────────────────────────────────────
model Value {
  id          String   @id
  title       String
  description String
  icon        String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Services
// ───────────────────────────────────────────────
model Service {
  id              String   @id
  number          String
  title           String
  summary         String
  description     String
  richDescription String   @default("") // HTML from Tiptap rich-text editor
  features        String[]
  icon            String
  image           String
  order           Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Products
// ───────────────────────────────────────────────
model Product {
  id                  String   @id
  slug                String   @unique
  name                String
  shortDescription    String
  description         String
  richDescription     String   @default("") // HTML from Tiptap rich-text editor
  applications        String[]
  typicalApplications String[]
  subProducts         String[]
  materials           String[]
  brands              String[]
  icon                String
  image               String
  order               Int      @default(0)
  updatedAt           DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Industries
// ───────────────────────────────────────────────
model Industry {
  id          String   @id
  slug        String   @unique
  name        String
  description String
  icon        String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Why Choose Us items
// ───────────────────────────────────────────────
model WhyChooseUsItem {
  id          String   @id
  title       String
  description String
  icon        String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Process steps
// ───────────────────────────────────────────────
model ProcessStep {
  id          String   @id
  number      String
  title       String
  description String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Testimonials
// ───────────────────────────────────────────────
model Testimonial {
  id        String   @id
  quote     String
  name      String
  company   String
  initials  String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Insights / Blog posts
// ───────────────────────────────────────────────
model InsightPost {
  id          String   @id
  title       String
  excerpt     String
  contentBody String   @default("") // Full article HTML from Tiptap
  category    String
  readTime    String
  date        String
  image       String
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Hero Section (single row, id = "main")
// ───────────────────────────────────────────────
model HeroSection {
  id               String   @id @default("main")
  badgeText        String   @default("UAE-Based Industrial Supplier · Est. 2019")
  showBadge        Boolean  @default(true)
  headline         String   @default("Your Industrial Partner for Quality, Speed & Support")
  subheadline      String   @default("UAE-based industrial supplier delivering high-quality industrial equipment, tools, and specialized brushes across the GCC.")
  ctaPrimaryText   String   @default("Request a Quote")
  ctaPrimaryHref   String   @default("/contact")
  ctaSecondaryText String   @default("Browse Products")
  ctaSecondaryHref String   @default("/products")
  backgroundImage  String   @default("/images/hero/hero-bg.png")
  overlayOpacity   Float    @default(0.55)
  showStats        Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Per-page SEO metadata
// ───────────────────────────────────────────────
model PageSeo {
  id             String   @id // "home" | "about" | "products" | "services" | "industries" | "insights" | "contact"
  title          String
  description    String
  ogImage        String   @default("/images/og/og-image.png")
  canonicalUrl   String   @default("")
  noIndex        Boolean  @default(false)
  structuredData String   @default("") // JSON-LD string blob
  updatedAt      DateTime @updatedAt
}

// ───────────────────────────────────────────────
// Homepage section visibility + display order
// ───────────────────────────────────────────────
model SectionConfig {
  id      String  @id // "hero" | "about" | "services" | "products" | "industries" | "why-choose-us" | "process" | "brands" | "testimonials" | "insights" | "cta" | "contact"
  visible Boolean @default(true)
  order   Int     @default(0)
  label   String  @default("")
}

// ───────────────────────────────────────────────
// Contact form inquiries
// ───────────────────────────────────────────────
model Inquiry {
  id              String   @id
  reference       String   @unique
  name            String
  email           String
  phone           String
  company         String
  productCategory String
  message         String
  status          String   @default("new")
  receivedAt      DateTime @default(now())
}